{
  "schema_version": 2,
  "meta": {
    "name": "健康生活移动界面",
    "author": "Cloud Dream Engine",
    "description": "冷灰纸面轻拟物：白面板浮起，橙/绿/紫仅作数据点缀，发送键蓝色"
  },
  "tokens": {
    "color-bg": "#E9EDF3",
    "color-panel": "#FFFFFF",
    "color-ink": "#1B2233",
    "color-muted": "#5A657A",
    "color-gray": "#E2E7EF",
    "color-orange": "#C4682A",
    "color-green": "#0E7C57",
    "color-purple": "#6A4BC4",
    "color-blue": "#2B5FE3",
    "radius-md": "14px",
    "radius-lg": "16px",
    "font-body": "\"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif"
  },
  "components": {},
  "state": {
    "active_tab": "chat",
    "checked_health_items": []
  },
  "layout": {
    "root": {
      "type": "stack",
      "class_name": "hl-mobile-shell",
      "direction": "vertical",
      "gap": "0",
      "padding": "0",
      "style": {
        "height": "100%",
        "min_height": "0",
        "overflow": "hidden"
      },
      "children": [
        {
          "type": "stack",
          "class_name": "hl-tabbar hl-tabbar--mobile-top",
          "direction": "horizontal",
          "gap": "0",
          "style": {
            "flex": "0 0 auto",
            "min_height": "0"
          },
          "children": [
            {
              "type": "stack",
              "class_name": "hl-tab-item-wrap",
              "style": {
                "flex": "1 1 0"
              },
              "children": [
                {
                  "type": "when",
                  "expr": "state.active_tab == 'chat' || state.active_tab == null",
                  "child": {
                    "type": "button",
                    "class_name": "hl-tab-btn hl-tab-btn--active hl-tab-btn--chat",
                    "label": "对话",
                    "variant": "ghost",
                    "action": {
                      "id": "logic.run",
                      "args": {
                        "handler": "ui.setTab",
                        "input": {
                          "tab": "chat"
                        }
                      },
                      "result_state": "active_tab",
                      "error_state": "tab_error",
                      "pending_state": "tab_pending"
                    }
                  }
                },
                {
                  "type": "when",
                  "expr": "state.active_tab != 'chat' && state.active_tab != null",
                  "child": {
                    "type": "button",
                    "class_name": "hl-tab-btn hl-tab-btn--chat",
                    "label": "对话",
                    "variant": "ghost",
                    "action": {
                      "id": "logic.run",
                      "args": {
                        "handler": "ui.setTab",
                        "input": {
                          "tab": "chat"
                        }
                      },
                      "result_state": "active_tab",
                      "error_state": "tab_error",
                      "pending_state": "tab_pending"
                    }
                  }
                }
              ]
            },
            {
              "type": "stack",
              "class_name": "hl-tab-item-wrap",
              "style": {
                "flex": "1 1 0"
              },
              "children": [
                {
                  "type": "when",
                  "expr": "state.active_tab == 'growth'",
                  "child": {
                    "type": "button",
                    "class_name": "hl-tab-btn hl-tab-btn--active hl-tab-btn--growth",
                    "label": "成长",
                    "variant": "ghost",
                    "action": {
                      "id": "logic.run",
                      "args": {
                        "handler": "ui.setTab",
                        "input": {
                          "tab": "growth"
                        }
                      },
                      "result_state": "active_tab",
                      "error_state": "tab_error",
                      "pending_state": "tab_pending"
                    }
                  }
                },
                {
                  "type": "when",
                  "expr": "state.active_tab != 'growth'",
                  "child": {
                    "type": "button",
                    "class_name": "hl-tab-btn hl-tab-btn--growth",
                    "label": "成长",
                    "variant": "ghost",
                    "action": {
                      "id": "logic.run",
                      "args": {
                        "handler": "ui.setTab",
                        "input": {
                          "tab": "growth"
                        }
                      },
                      "result_state": "active_tab",
                      "error_state": "tab_error",
                      "pending_state": "tab_pending"
                    }
                  }
                }
              ]
            },
            {
              "type": "stack",
              "class_name": "hl-tab-item-wrap",
              "style": {
                "flex": "1 1 0"
              },
              "children": [
                {
                  "type": "when",
                  "expr": "state.active_tab == 'profile'",
                  "child": {
                    "type": "button",
                    "class_name": "hl-tab-btn hl-tab-btn--active hl-tab-btn--profile",
                    "label": "我的",
                    "variant": "ghost",
                    "action": {
                      "id": "logic.run",
                      "args": {
                        "handler": "ui.setTab",
                        "input": {
                          "tab": "profile"
                        }
                      },
                      "result_state": "active_tab",
                      "error_state": "tab_error",
                      "pending_state": "tab_pending"
                    }
                  }
                },
                {
                  "type": "when",
                  "expr": "state.active_tab != 'profile'",
                  "child": {
                    "type": "button",
                    "class_name": "hl-tab-btn hl-tab-btn--profile",
                    "label": "我的",
                    "variant": "ghost",
                    "action": {
                      "id": "logic.run",
                      "args": {
                        "handler": "ui.setTab",
                        "input": {
                          "tab": "profile"
                        }
                      },
                      "result_state": "active_tab",
                      "error_state": "tab_error",
                      "pending_state": "tab_pending"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "stack",
          "class_name": "hl-mobile-body",
          "direction": "vertical",
          "gap": "0",
          "style": {
            "flex": "1 1 0",
            "min_height": "0"
          },
          "children": [
            {
              "type": "when",
              "expr": "state.active_tab == 'chat' || state.active_tab == null",
              "child": {
                "type": "stack",
                "class_name": "hl-pane hl-pane--chat",
                "direction": "vertical",
                "gap": "0",
                "style": {
                  "flex": "1 1 0",
                  "min_height": "0",
                  "height": "100%"
                },
                "children": [
                  {
                    "type": "component",
                    "component": "message_list",
                    "class_name": "hl-mobile-messages",
                    "style": {
                      "flex": "1 1 0",
                      "min_height": "0"
                    },
                    "props": {
                      "auto_scroll": true,
                      "show_pending_state": true,
                      "show_agent_reasoning": false,
                      "show_typing_indicator": true,
                      "mobile_simple": true,
                      "show_scroll_controls": true
                    }
                  },
                  {
                    "type": "component",
                    "component": "input_composer",
                    "class_name": "hl-mobile-composer",
                    "style": {
                      "flex": "0 0 auto",
                      "min_height": "0"
                    },
                    "props": {
                      "placeholder": "说说今天的饮食、训练或目标…",
                      "submit_label": "发送",
                      "editing_submit_label": "更新",
                      "show_image_button": true,
                      "show_audio_button": true,
                      "show_session_meta": false,
                      "enter_to_submit": true
                    }
                  }
                ]
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab == 'growth'",
              "child": {
                "type": "stack",
                "class_name": "hl-pane hl-pane--growth",
                "direction": "vertical",
                "gap": "12px",
                "style": {
                  "flex": "1 1 0",
                  "min_height": "0",
                  "overflow_y": "auto",
                  "padding": "12px 14px 16px"
                },
                "children": [
                  {
                    "type": "stack",
                    "class_name": "hl-growth-head",
                    "direction": "vertical",
                    "gap": "6px",
                    "children": [
                      {
                        "type": "text",
                        "class_name": "hl-growth-kicker",
                        "text": "当前目标"
                      },
                      {
                        "type": "text",
                        "class_name": "hl-growth-title",
                        "text": "{{ attributes.health_goal_type }}"
                      },
                      {
                        "type": "text",
                        "class_name": "hl-growth-sub",
                        "text": "{{ attributes.health_goal_detail }}"
                      }
                    ]
                  },
                  {
                    "type": "stack",
                    "class_name": "hl-energy-card",
                    "direction": "vertical",
                    "gap": "12px",
                    "children": [
                      {
                        "type": "stack",
                        "class_name": "hl-ring-core",
                        "direction": "vertical",
                        "gap": "4px",
                        "style": {
                          "align_self": "center"
                        },
                        "children": [
                          {
                            "type": "text",
                            "class_name": "hl-ring-label",
                            "text": "净能量平衡"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-ring-value",
                            "text": "{{ attributes.health_energy_net }}"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-ring-unit",
                            "text": "kcal"
                          }
                        ]
                      },
                      {
                        "type": "text",
                        "class_name": "hl-ring-legend",
                        "text": "摄入 − 消耗。负值表示今日有热量缺口。"
                      }
                    ]
                  },
                  {
                    "type": "stack",
                    "class_name": "hl-stat-grid",
                    "direction": "horizontal",
                    "gap": "10px",
                    "wrap": true,
                    "children": [
                      {
                        "type": "stack",
                        "class_name": "hl-stat-card hl-stat-card--in",
                        "direction": "vertical",
                        "gap": "6px",
                        "style": {
                          "flex": "1 1 140px",
                          "min_width": "140px"
                        },
                        "children": [
                          {
                            "type": "text",
                            "class_name": "hl-stat-label",
                            "text": "今日摄入"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-stat-value",
                            "text": "{{ attributes.health_intake_kcal }} kcal"
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "class_name": "hl-stat-card hl-stat-card--out",
                        "direction": "vertical",
                        "gap": "6px",
                        "style": {
                          "flex": "1 1 140px",
                          "min_width": "140px"
                        },
                        "children": [
                          {
                            "type": "text",
                            "class_name": "hl-stat-label",
                            "text": "今日消耗"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-stat-value",
                            "text": "{{ attributes.health_burn_kcal }} kcal"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "stack",
                    "class_name": "hl-check-card",
                    "direction": "vertical",
                    "gap": "10px",
                    "children": [
                      {
                        "type": "text",
                        "class_name": "hl-section-label",
                        "text": "今日行动清单"
                      },
                      {
                        "type": "for_each",
                        "source": "$attributes.health_checklist",
                        "item_as": "task",
                        "empty": {
                          "type": "text",
                          "class_name": "hl-check-empty",
                          "text": "还没有今日清单，在对话里让小助手帮你列 1-3 条今天要做的事。"
                        },
                        "child": {
                          "type": "checkbox",
                          "class_name": "hl-check-item",
                          "label": "$task",
                          "value": "$task",
                          "bind_checked_list": "checked_health_items"
                        }
                      },
                      {
                        "type": "button",
                        "class_name": "hl-check-confirm",
                        "label": "确认完成",
                        "variant": "ghost",
                        "disabled_when_empty_state": "checked_health_items",
                        "action": {
                          "id": "submit_message",
                          "mode": "submit",
                          "content_template": "【清单确认】我已完成以下行动清单事项：{{state.checked_health_items}}。请从 health_checklist 中移除这些条目，并简短鼓励；若清单为空可再给 1-2 条新建议。"
                        }
                      },
                      {
                        "type": "text",
                        "class_name": "hl-caption",
                        "text": "勾选后点「确认完成」，会发给小助手更新清单。"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "class_name": "hl-caption",
                    "text": "在「对话」里告知小助手今日饮食或运动，这里的数据会同步更新。"
                  }
                ]
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab == 'profile'",
              "child": {
                "type": "stack",
                "class_name": "hl-pane hl-pane--profile",
                "direction": "vertical",
                "gap": "12px",
                "style": {
                  "flex": "1 1 0",
                  "min_height": "0",
                  "overflow_y": "auto",
                  "padding": "12px 14px 16px"
                },
                "children": [
                  {
                    "type": "stack",
                    "class_name": "hl-metric-pair",
                    "direction": "horizontal",
                    "gap": "10px",
                    "wrap": true,
                    "children": [
                      {
                        "type": "stack",
                        "class_name": "hl-metric-hero hl-metric-hero--bmi",
                        "direction": "vertical",
                        "gap": "6px",
                        "style": {
                          "flex": "1 1 140px",
                          "min_width": "140px"
                        },
                        "children": [
                          {
                            "type": "text",
                            "class_name": "hl-metric-hero-label",
                            "text": "BMI"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-metric-hero-num",
                            "text": "{{ attributes.health_bmi }}"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-metric-hero-tag",
                            "text": "{{ attributes.health_bmi_label }}"
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "class_name": "hl-metric-hero hl-metric-hero--bmr",
                        "direction": "vertical",
                        "gap": "6px",
                        "style": {
                          "flex": "1 1 140px",
                          "min_width": "140px"
                        },
                        "children": [
                          {
                            "type": "text",
                            "class_name": "hl-metric-hero-label",
                            "text": "基础代谢 BMR"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-metric-hero-num",
                            "text": "{{ attributes.health_bmr }}"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-metric-hero-tag",
                            "text": "kcal / 天"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "stack",
                    "class_name": "hl-card hl-card--metrics",
                    "direction": "vertical",
                    "gap": "0",
                    "children": [
                      {
                        "type": "stack",
                        "class_name": "hl-metric",
                        "direction": "horizontal",
                        "gap": "8px",
                        "children": [
                          {
                            "type": "text",
                            "class_name": "hl-metric-label",
                            "text": "身高"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-metric-value",
                            "text": "{{ attributes.health_height_cm }} cm"
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "class_name": "hl-metric",
                        "direction": "horizontal",
                        "gap": "8px",
                        "children": [
                          {
                            "type": "text",
                            "class_name": "hl-metric-label",
                            "text": "体重"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-metric-value",
                            "text": "{{ attributes.health_weight_kg }} kg"
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "class_name": "hl-metric",
                        "direction": "horizontal",
                        "gap": "8px",
                        "children": [
                          {
                            "type": "text",
                            "class_name": "hl-metric-label",
                            "text": "年龄"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-metric-value",
                            "text": "{{ attributes.health_age }} 岁"
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "class_name": "hl-metric",
                        "direction": "horizontal",
                        "gap": "8px",
                        "children": [
                          {
                            "type": "text",
                            "class_name": "hl-metric-label",
                            "text": "性别"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-metric-value",
                            "text": "{{ attributes.health_gender }}"
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "class_name": "hl-metric",
                        "direction": "horizontal",
                        "gap": "8px",
                        "children": [
                          {
                            "type": "text",
                            "class_name": "hl-metric-label",
                            "text": "目标体重"
                          },
                          {
                            "type": "text",
                            "class_name": "hl-metric-value",
                            "text": "{{ attributes.health_target_weight }} kg"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "stack",
                    "class_name": "hl-card",
                    "direction": "vertical",
                    "gap": "8px",
                    "children": [
                      {
                        "type": "text",
                        "class_name": "hl-card-title",
                        "text": "BMR 怎么算"
                      },
                      {
                        "type": "text",
                        "class_name": "hl-card-body",
                        "text": "Mifflin-St Jeor：男 10×体重 + 6.25×身高 − 5×年龄 + 5；女 − 161。"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "class_name": "hl-caption",
                    "text": "在「对话」中告知小助手身高、体重、年龄、性别，档案与 BMI/BMR 会自动更新。"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "custom_css": "&.game-root,\n&.game-root--mobile-session {\n  color: #1b2233;\n  background: #e9edf3;\n  font-family: \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif;\n}\n& .hl-mobile-topbar { background: #fff; border-bottom: 1px solid rgba(27,34,51,.08); }\n& .hl-mobile-header .game-simple-top {\n  color: #1b2233;\n  background: transparent;\n  border: 0;\n  box-shadow: none;\n}\n& .hl-mobile-header .game-simple-world { color: #5a657a; }\n& .hl-mobile-header .game-simple-place { color: #1b2233; font-weight: 700; }\n& .hl-mobile-actions .game-back-btn,\n& .hl-mobile-actions button {\n  color: #1b2233;\n  background: #fff;\n  border: 0;\n  border-radius: 12px;\n}\n& .hl-mobile-messages .game-chat-messages { background: transparent; }\n& .hl-mobile-messages .game-message-row--agent .game-message,\n& .hl-mobile-messages .game-message--agent {\n  color: #1b2233;\n  background: #fff;\n  border: 0;\n  border-radius: 16px;\n}\n& .hl-mobile-messages .game-message-row--player .game-message,\n& .hl-mobile-messages .game-message--player {\n  color: #1b2233;\n  background: #e2e7ef;\n  border: 0;\n  border-radius: 16px;\n}\n& .hl-mobile-messages .game-message-speaker { color: #6a4bc4; }\n& .hl-mobile-composer { background: #fff; border-top: 1px solid rgba(27,34,51,.08); }\n& .hl-mobile-composer textarea,\n& .hl-mobile-composer .game-textarea {\n  color: #1b2233;\n  background: #e2e7ef;\n  border: 0;\n  border-radius: 14px;\n}\n& .hl-mobile-composer .game-send-btn,\n& .hl-mobile-composer .game-submit-btn,\n& .hl-mobile-composer .game-ui-button[data-variant=\"primary\"] {\n  color: #fff !important;\n  background: #2b5fe3 !important;\n  border: 0;\n  border-radius: 12px;\n}\n& .hl-card { background: #fff; border-radius: 16px; }\n& .hl-card-title { color: #1b2233; font-weight: 700; }\n& .hl-card-body { color: #5a657a; }\n& .hl-caption, & .hl-section-label, & .hl-metric-label { color: #5a657a; }\n& .hl-goal-btn--orange::before { background: #c4682a; }\n& .hl-goal-btn--green::before { background: #0e7c57; }\n& .hl-goal-btn--purple::before { background: #6a4bc4; }\n& .hl-tab-btn--active.hl-tab-btn--chat::after { background: #0e7c57; }\n& .hl-tab-btn--active.hl-tab-btn--growth::after { background: #c4682a; }\n& .hl-tab-btn--active.hl-tab-btn--profile::after { background: #6a4bc4; }\n&.game-root--mobile-session {\n  --game-ui-composer-max-width: 100%;\n  --game-ui-composer-margin-inline: 0;\n  --game-ui-input-max-width: none;\n  --game-ui-message-max-width: min(100%, 640px);\n  --game-ui-chat-gutter-x: 12px;\n  --game-ui-chat-gutter-y: 14px;\n  --game-ui-textarea-min-height: 44px;\n  --game-ui-action-btn-min-h: 32px;\n  --game-ui-action-btn-min-w: 34px;\n  --game-ui-scroll-btn-size: 32px;\n}"
}
