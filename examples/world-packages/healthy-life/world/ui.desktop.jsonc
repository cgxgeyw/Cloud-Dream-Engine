{
  "schema_version": 2,
  "meta": {
    "name": "健康生活桌面界面",
    "author": "Cloud Dream Engine",
    "description": "四页签与移动同构：对话/记录/计划/我的"
  },
  "state": {
    "active_tab": "chat",
    "chart_mode": "week",
    "checked_health_items": [],
    "stats": null,
    "stats_error": "",
    "stats_loading": false
  },
  "layout": {
    "root": {
      "type": "stack",
      "class_name": "hl-desktop-shell",
      "direction": "vertical",
      "gap": "0",
      "style": {
        "height": "100%",
        "min_height": "0",
        "overflow": "hidden"
      },
      "children": [
        {
          "type": "stack",
          "class_name": "hl-desktop-topbar",
          "direction": "horizontal",
          "gap": "12px",
          "style": { "flex": "0 0 auto", "align_items": "center" },
          "children": [
            {
              "type": "stack",
              "class_name": "hl-desktop-header",
              "direction": "vertical",
              "gap": "2px",
              "style": { "flex": "1 1 auto", "min_width": "0" },
              "children": [
                { "type": "text", "class_name": "hl-growth-kicker", "text": "健康生活" },
                { "type": "text", "class_name": "hl-growth-title", "text": "对话 · 记录 · 计划 · 我的" }
              ]
            }
          ]
        },
        {
          "type": "stack",
          "class_name": "hl-tabbar hl-tabbar--desktop-top",
          "direction": "horizontal",
          "gap": "8px",
          "style": { "flex": "0 0 auto" },
          "children": [
            {
              "type": "when",
              "expr": "state.active_tab == 'chat' || state.active_tab == null || state.active_tab == 'growth'",
              "child": {
                "type": "button",
                "class_name": "hl-tab-btn hl-tab-btn--active hl-tab-btn--chat",
                "label": "对话",
                "action": { "id": "set_state", "args": { "key": "active_tab", "value": "chat" }, "result_state": "active_tab" }
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab != 'chat' && state.active_tab != null && state.active_tab != 'growth'",
              "child": {
                "type": "button",
                "class_name": "hl-tab-btn hl-tab-btn--chat",
                "label": "对话",
                "action": { "id": "set_state", "args": { "key": "active_tab", "value": "chat" }, "result_state": "active_tab" }
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab == 'records'",
              "child": {
                "type": "button",
                "class_name": "hl-tab-btn hl-tab-btn--active hl-tab-btn--records",
                "label": "记录",
                "action": { "id": "set_state", "args": { "key": "active_tab", "value": "records" }, "result_state": "active_tab" }
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab != 'records'",
              "child": {
                "type": "button",
                "class_name": "hl-tab-btn hl-tab-btn--records",
                "label": "记录",
                "action": { "id": "set_state", "args": { "key": "active_tab", "value": "records" }, "result_state": "active_tab" }
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab == 'plan'",
              "child": {
                "type": "button",
                "class_name": "hl-tab-btn hl-tab-btn--active hl-tab-btn--plan",
                "label": "计划",
                "action": { "id": "set_state", "args": { "key": "active_tab", "value": "plan" }, "result_state": "active_tab" }
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab != 'plan'",
              "child": {
                "type": "button",
                "class_name": "hl-tab-btn hl-tab-btn--plan",
                "label": "计划",
                "action": { "id": "set_state", "args": { "key": "active_tab", "value": "plan" }, "result_state": "active_tab" }
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab == 'profile'",
              "child": {
                "type": "button",
                "class_name": "hl-tab-btn hl-tab-btn--active hl-tab-btn--profile",
                "label": "我的",
                "action": { "id": "set_state", "args": { "key": "active_tab", "value": "profile" }, "result_state": "active_tab" }
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab != 'profile'",
              "child": {
                "type": "button",
                "class_name": "hl-tab-btn hl-tab-btn--profile",
                "label": "我的",
                "action": { "id": "set_state", "args": { "key": "active_tab", "value": "profile" }, "result_state": "active_tab" }
              }
            }
          ]
        },
        {
          "type": "stack",
          "class_name": "hl-desktop-body",
          "direction": "vertical",
          "gap": "0",
          "style": { "flex": "1 1 0", "min_height": "0" },
          "children": [
            {
              "type": "when",
              "expr": "state.active_tab == 'chat' || state.active_tab == null || state.active_tab == 'growth'",
              "child": {
                "type": "stack",
                "class_name": "hl-desktop-chat",
                "direction": "vertical",
                "gap": "0",
                "style": { "flex": "1 1 0", "min_height": "0" },
                "children": [
                  {
                    "type": "component",
                    "component": "message_list",
                    "class_name": "hl-desktop-messages",
                    "style": { "flex": "1 1 0", "min_height": "0" },
                    "props": {
                      "auto_scroll": true,
                      "show_pending_state": true,
                      "show_agent_reasoning": true,
                      "show_typing_indicator": true,
                      "mobile_simple": false
                    }
                  },
                  {
                    "type": "component",
                    "component": "input_composer",
                    "class_name": "hl-desktop-composer",
                    "style": { "flex": "0 0 auto" },
                    "props": {
                      "placeholder": "说说今天的饮食、训练或目标…",
                      "submit_label": "发送",
                      "show_image_button": true,
                      "show_audio_button": true,
                      "enter_to_submit": true,
                      "show_session_meta": false
                    }
                  }
                ]
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab == 'records'",
              "child": {
                "type": "stack",
                "class_name": "hl-pane hl-pane--records",
                "direction": "vertical",
                "gap": "12px",
                "style": {
                  "flex": "1 1 0",
                  "min_height": "0",
                  "overflow_y": "auto",
                  "padding": "16px 20px 20px"
                },
                "children": [
                  {
                    "type": "stack",
                    "class_name": "hl-energy-card",
                    "direction": "vertical",
                    "gap": "12px",
                    "children": [
                      {
                        "type": "stack",
                        "class_name": "hl-ring-core",
                        "direction": "vertical",
                        "gap": "4px",
                        "style": { "align_self": "center" },
                        "children": [
                          { "type": "text", "class_name": "hl-ring-label", "text": "今日净能量" },
                          { "type": "text", "class_name": "hl-ring-value", "text": "{{ attributes.health_energy_net }}" },
                          { "type": "text", "class_name": "hl-ring-unit", "text": "kcal" }
                        ]
                      },
                      {
                        "type": "stack",
                        "class_name": "hl-stat-grid",
                        "direction": "horizontal",
                        "gap": "12px",
                        "wrap": true,
                        "children": [
                          {
                            "type": "stack",
                            "class_name": "hl-stat-card hl-stat-card--in",
                            "direction": "vertical",
                            "gap": "6px",
                            "style": { "flex": "1 1 160px" },
                            "children": [
                              { "type": "text", "class_name": "hl-stat-label", "text": "今日摄入" },
                              { "type": "text", "class_name": "hl-stat-value", "text": "{{ attributes.health_intake_kcal }} kcal" }
                            ]
                          },
                          {
                            "type": "stack",
                            "class_name": "hl-stat-card hl-stat-card--out",
                            "direction": "vertical",
                            "gap": "6px",
                            "style": { "flex": "1 1 160px" },
                            "children": [
                              { "type": "text", "class_name": "hl-stat-label", "text": "今日消耗" },
                              { "type": "text", "class_name": "hl-stat-value", "text": "{{ attributes.health_burn_kcal }} kcal" }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "class_name": "hl-check-confirm",
                    "label": "同步统计（写入今日并刷新）",
                    "action": {
                      "id": "logic.run",
                      "args": {
                        "handler": "health.syncStats",
                        "input": {
                          "intake": "$attributes.health_intake_kcal",
                          "burn": "$attributes.health_burn_kcal",
                          "net": "$attributes.health_energy_net",
                          "bmr": "$attributes.health_bmr",
                          "steps": 0
                        }
                      },
                      "result_state": "stats",
                      "error_state": "stats_error",
                      "pending_state": "stats_loading"
                    }
                  },
                  {
                    "type": "stack",
                    "class_name": "hl-card hl-chart-card",
                    "direction": "vertical",
                    "gap": "10px",
                    "children": [
                      { "type": "text", "class_name": "hl-section-label", "text": "消耗统计" },
                      {
                        "type": "stack",
                        "class_name": "hl-chart-modes",
                        "direction": "horizontal",
                        "gap": "8px",
                        "children": [
                          {
                            "type": "when",
                            "expr": "state.chart_mode == 'day' || state.chart_mode == null",
                            "child": {
                              "type": "button",
                              "class_name": "hl-mode-btn hl-mode-btn--active",
                              "label": "日",
                              "action": { "id": "set_state", "args": { "key": "chart_mode", "value": "day" }, "result_state": "chart_mode" }
                            }
                          },
                          {
                            "type": "when",
                            "expr": "state.chart_mode != 'day' && state.chart_mode != null",
                            "child": {
                              "type": "button",
                              "class_name": "hl-mode-btn",
                              "label": "日",
                              "action": { "id": "set_state", "args": { "key": "chart_mode", "value": "day" }, "result_state": "chart_mode" }
                            }
                          },
                          {
                            "type": "when",
                            "expr": "state.chart_mode == 'week'",
                            "child": {
                              "type": "button",
                              "class_name": "hl-mode-btn hl-mode-btn--active",
                              "label": "周",
                              "action": { "id": "set_state", "args": { "key": "chart_mode", "value": "week" }, "result_state": "chart_mode" }
                            }
                          },
                          {
                            "type": "when",
                            "expr": "state.chart_mode != 'week'",
                            "child": {
                              "type": "button",
                              "class_name": "hl-mode-btn",
                              "label": "周",
                              "action": { "id": "set_state", "args": { "key": "chart_mode", "value": "week" }, "result_state": "chart_mode" }
                            }
                          },
                          {
                            "type": "when",
                            "expr": "state.chart_mode == 'month'",
                            "child": {
                              "type": "button",
                              "class_name": "hl-mode-btn hl-mode-btn--active",
                              "label": "月",
                              "action": { "id": "set_state", "args": { "key": "chart_mode", "value": "month" }, "result_state": "chart_mode" }
                            }
                          },
                          {
                            "type": "when",
                            "expr": "state.chart_mode != 'month'",
                            "child": {
                              "type": "button",
                              "class_name": "hl-mode-btn",
                              "label": "月",
                              "action": { "id": "set_state", "args": { "key": "chart_mode", "value": "month" }, "result_state": "chart_mode" }
                            }
                          }
                        ]
                      },
                      { "type": "text", "class_name": "hl-caption", "text": "深蓝=消耗 · 浅蓝=摄入。柱高表示当日数值。" },
                      {
                        "type": "when",
                        "expr": "state.stats == null",
                        "child": {
                          "type": "text",
                          "class_name": "hl-check-empty",
                          "text": "还没有历史数据。点「同步统计」把今日属性写入 health.energy_days。"
                        }
                      },
                      {
                        "type": "when",
                        "expr": "state.chart_mode == 'week' && state.stats != null",
                        "child": {
                          "type": "stack",
                          "class_name": "hl-bars",
                          "direction": "horizontal",
                          "gap": "8px",
                          "children": [
                            {
                              "type": "for_each",
                              "source": "$state.stats.week_bars",
                              "item_as": "bar",
                              "empty": { "type": "text", "class_name": "hl-check-empty", "text": "本周暂无数据" },
                              "child": {
                                "type": "stack",
                                "class_name": "hl-bar-col",
                                "direction": "vertical",
                                "gap": "4px",
                                "style": { "flex": "1 1 0" },
                                "children": [
                                  {
                                    "type": "stack",
                                    "class_name": "hl-bar-pair",
                                    "direction": "horizontal",
                                    "gap": "3px",
                                    "style": { "align_items": "flex-end", "height": "140px" },
                                    "children": [
                                      { "type": "stack", "class_name": "hl-bar hl-bar--in", "style": { "height": "{{ bar.h_in }}", "flex": "1 1 0" } },
                                      { "type": "stack", "class_name": "hl-bar hl-bar--out", "style": { "height": "{{ bar.h_burn }}", "flex": "1 1 0" } }
                                    ]
                                  },
                                  { "type": "text", "class_name": "hl-bar-label", "text": "{{ bar.label }}" }
                                ]
                              }
                            }
                          ]
                        }
                      },
                      {
                        "type": "when",
                        "expr": "state.chart_mode == 'month' && state.stats != null",
                        "child": {
                          "type": "stack",
                          "class_name": "hl-bars hl-bars--month",
                          "direction": "horizontal",
                          "gap": "3px",
                          "style": { "overflow_x": "auto" },
                          "children": [
                            {
                              "type": "for_each",
                              "source": "$state.stats.month_bars",
                              "item_as": "bar",
                              "empty": { "type": "text", "class_name": "hl-check-empty", "text": "本月暂无数据" },
                              "child": {
                                "type": "stack",
                                "class_name": "hl-bar-col",
                                "direction": "vertical",
                                "gap": "2px",
                                "style": { "flex": "0 0 16px" },
                                "children": [
                                  {
                                    "type": "stack",
                                    "class_name": "hl-bar-pair",
                                    "direction": "horizontal",
                                    "gap": "1px",
                                    "style": { "align_items": "flex-end", "height": "120px" },
                                    "children": [
                                      { "type": "stack", "class_name": "hl-bar hl-bar--in", "style": { "height": "{{ bar.h_in }}", "flex": "1 1 0" } },
                                      { "type": "stack", "class_name": "hl-bar hl-bar--out", "style": { "height": "{{ bar.h_burn }}", "flex": "1 1 0" } }
                                    ]
                                  },
                                  { "type": "text", "class_name": "hl-bar-label hl-bar-label--tiny", "text": "{{ bar.label }}" }
                                ]
                              }
                            }
                          ]
                        }
                      },
                      {
                        "type": "when",
                        "expr": "state.chart_mode == 'day' && state.stats != null",
                        "child": {
                          "type": "stack",
                          "class_name": "hl-day-list",
                          "direction": "vertical",
                          "gap": "8px",
                          "children": [
                            {
                              "type": "for_each",
                              "source": "$state.stats.day_list",
                              "item_as": "day",
                              "empty": { "type": "text", "class_name": "hl-check-empty", "text": "暂无每日记录" },
                              "child": {
                                "type": "stack",
                                "class_name": "hl-day-row",
                                "direction": "horizontal",
                                "gap": "12px",
                                "children": [
                                  { "type": "text", "class_name": "hl-day-date", "text": "{{ day.date }}" },
                                  { "type": "text", "class_name": "hl-day-num hl-day-num--in", "text": "摄 {{ day.intake }}" },
                                  { "type": "text", "class_name": "hl-day-num hl-day-num--out", "text": "耗 {{ day.burn }}" },
                                  { "type": "text", "class_name": "hl-day-num", "text": "净 {{ day.net }}" }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab == 'plan'",
              "child": {
                "type": "stack",
                "class_name": "hl-pane hl-pane--growth",
                "direction": "vertical",
                "gap": "12px",
                "style": { "flex": "1 1 0", "min_height": "0", "overflow_y": "auto", "padding": "16px 20px 20px" },
                "children": [
                  {
                    "type": "stack",
                    "class_name": "hl-growth-head",
                    "direction": "vertical",
                    "gap": "6px",
                    "children": [
                      { "type": "text", "class_name": "hl-growth-kicker", "text": "当前目标" },
                      { "type": "text", "class_name": "hl-growth-title", "text": "{{ attributes.health_goal_type }}" },
                      { "type": "text", "class_name": "hl-growth-sub", "text": "{{ attributes.health_goal_detail }}" }
                    ]
                  },
                  {
                    "type": "stack",
                    "class_name": "hl-card",
                    "direction": "vertical",
                    "gap": "8px",
                    "children": [
                      { "type": "text", "class_name": "hl-section-label", "text": "今日重点" },
                      { "type": "text", "class_name": "hl-card-body", "text": "{{ attributes.health_weekly_focus }}" }
                    ]
                  },
                  {
                    "type": "stack",
                    "class_name": "hl-check-card",
                    "direction": "vertical",
                    "gap": "10px",
                    "children": [
                      { "type": "text", "class_name": "hl-section-label", "text": "今日行动清单" },
                      {
                        "type": "for_each",
                        "source": "$attributes.health_checklist",
                        "item_as": "task",
                        "empty": { "type": "text", "class_name": "hl-check-empty", "text": "对话里让小助手列今日清单。" },
                        "child": {
                          "type": "checkbox",
                          "class_name": "hl-check-item",
                          "label": "$task",
                          "value": "$task",
                          "bind_checked_list": "checked_health_items"
                        }
                      },
                      {
                        "type": "button",
                        "class_name": "hl-check-confirm",
                        "label": "确认完成",
                        "disabled_when_empty_state": "checked_health_items",
                        "action": {
                          "id": "submit_message",
                          "mode": "submit",
                          "content_template": "【清单确认】我已完成以下行动清单事项：{{state.checked_health_items}}。请从 health_checklist 中移除这些条目，并简短鼓励；若清单为空可再给 1-2 条新建议。"
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "when",
              "expr": "state.active_tab == 'profile'",
              "child": {
                "type": "stack",
                "class_name": "hl-pane hl-pane--profile",
                "direction": "vertical",
                "gap": "12px",
                "style": { "flex": "1 1 0", "min_height": "0", "overflow_y": "auto", "padding": "16px 20px 20px" },
                "children": [
                  {
                    "type": "stack",
                    "class_name": "hl-metric-pair",
                    "direction": "horizontal",
                    "gap": "12px",
                    "wrap": true,
                    "children": [
                      {
                        "type": "stack",
                        "class_name": "hl-metric-hero",
                        "direction": "vertical",
                        "gap": "6px",
                        "style": { "flex": "1 1 180px" },
                        "children": [
                          { "type": "text", "class_name": "hl-metric-hero-label", "text": "BMI" },
                          { "type": "text", "class_name": "hl-metric-hero-num", "text": "{{ attributes.health_bmi }}" },
                          { "type": "text", "class_name": "hl-metric-hero-tag", "text": "{{ attributes.health_bmi_label }}" }
                        ]
                      },
                      {
                        "type": "stack",
                        "class_name": "hl-metric-hero",
                        "direction": "vertical",
                        "gap": "6px",
                        "style": { "flex": "1 1 180px" },
                        "children": [
                          { "type": "text", "class_name": "hl-metric-hero-label", "text": "基础代谢 BMR" },
                          { "type": "text", "class_name": "hl-metric-hero-num", "text": "{{ attributes.health_bmr }}" },
                          { "type": "text", "class_name": "hl-metric-hero-tag", "text": "kcal / 天" }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "stack",
                    "class_name": "hl-card hl-card--metrics",
                    "direction": "vertical",
                    "gap": "0",
                    "children": [
                      {
                        "type": "stack",
                        "class_name": "hl-metric",
                        "direction": "horizontal",
                        "gap": "8px",
                        "children": [
                          { "type": "text", "class_name": "hl-metric-label", "text": "身高" },
                          { "type": "text", "class_name": "hl-metric-value", "text": "{{ attributes.health_height_cm }} cm" }
                        ]
                      },
                      {
                        "type": "stack",
                        "class_name": "hl-metric",
                        "direction": "horizontal",
                        "gap": "8px",
                        "children": [
                          { "type": "text", "class_name": "hl-metric-label", "text": "体重" },
                          { "type": "text", "class_name": "hl-metric-value", "text": "{{ attributes.health_weight_kg }} kg" }
                        ]
                      },
                      {
                        "type": "stack",
                        "class_name": "hl-metric",
                        "direction": "horizontal",
                        "gap": "8px",
                        "children": [
                          { "type": "text", "class_name": "hl-metric-label", "text": "年龄" },
                          { "type": "text", "class_name": "hl-metric-value", "text": "{{ attributes.health_age }} 岁" }
                        ]
                      },
                      {
                        "type": "stack",
                        "class_name": "hl-metric",
                        "direction": "horizontal",
                        "gap": "8px",
                        "children": [
                          { "type": "text", "class_name": "hl-metric-label", "text": "性别" },
                          { "type": "text", "class_name": "hl-metric-value", "text": "{{ attributes.health_gender }}" }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "custom_css": "&.game-root--desktop-session{color:#1b2233;background:#e9edf3;font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;}\n& .hl-tab-btn--active.hl-tab-btn--records::after{background:#2b5fe3;}\n& .hl-tab-btn--active.hl-tab-btn--plan::after{background:#c4682a;}\n& .hl-chart-card{background:#fff;border-radius:16px;padding:16px;}\n& .hl-mode-btn{min-height:36px;padding:0 16px;border:0;border-radius:10px;background:#e2e7ef;color:#5a657a;font-weight:600;}\n& .hl-mode-btn--active{background:#fff;color:#1b2233;box-shadow:-2px -2px 5px rgba(255,255,255,.95),3px 3px 8px rgba(100,116,139,.12);}\n& .hl-bar{min-height:2px;border-radius:6px 6px 2px 2px;}\n& .hl-bar--in{background:var(--hl-bar-in) !important;}\n& .hl-bar--out{background:var(--hl-bar-out) !important;}\n& .hl-bar--selected,& .hl-bar--on{background:var(--hl-bar-out) !important;box-shadow:0 2px 8px rgba(26,79,180,.28);}\n& .hl-bar--idle,& .hl-bar--off{background:var(--hl-bar-in) !important;}\n& .hl-bar-value{font-size:11px;font-weight:700;color:#1a4fb4;text-align:center;}\n& .hl-bar-label{font-size:11px;color:#8b95a8;text-align:center;}\n& .hl-bar-label--selected{color:#1a4fb4;font-weight:700;}\n& .hl-day-row{padding:8px 12px;border-radius:12px;background:#fff;box-shadow:1px 2px 6px rgba(100,116,139,.1);}\n& .hl-day-num--in{color:#c4682a;}\n& .hl-day-num--out{color:#0e7c57;}"
}
