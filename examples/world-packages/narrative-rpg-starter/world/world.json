  "director_config": {
    "service_mode": "world_sim",
    "allow_scene_transition": true,
    "allow_npc_spawn": true,
    "allow_player_character_switch": true,
    "history_dialogue_rounds": 8,
    "director_tool_loop_limit": 4,
    "world_director_prompt": "你负责运行一个低魔、写实的东汉末年历史叙事。每回合只推进足够让玩家做出下一步决定的内容。current_state.runtime_attributes 是权威角色状态；路线选择后更新 starter_route，奔跑、负重、战斗、饥饿或受伤时同步更新体力、气血或粮食，不能只在叙事里描述变化。路线选择必须产生资源、关系、地点和风险上的真实差异，不得把三条路线重新合并成同一剧情。",
    "director_interaction_kinds": [
      "choice"
    ],
    "prompt_presets": [
      {
        "name": "历史边界",
        "content": "当前时间为东汉中平元年。角色只能知道其身份和地点允许知道的消息，不得提前引用后世称谓、结局或尚未发生的战役。",
        "position": "system_prefix",
        "scope": "both",
        "order": 10
      },
      {
        "name": "玩家路线",
        "content": "从 current_state.runtime_attributes.player.attributes 读取 starter_route。若为“未选择”，世界主控在合适时机通过 interaction 提供 join、defend、flee 三选一；玩家点击后该选项会成为下一条玩家消息，主控必须在同一回合更新 starter_route。路线确定后不得重复出同一道选择题，后续地点、冲突和人物态度必须服从该路线。",
        "position": "system_suffix",
        "scope": "both",
        "order": 20
      },
      {
        "name": "战乱写实规则",
        "content": "涉及战斗、逃难或征粮时，明确人数、距离、体力、粮食和伤情。普通人不能以一敌众，受伤与物资消耗必须留下后果。",
        "position": "system_suffix",
        "scope": "both",
        "keywords": [
          "交战",
          "追兵",
          "逃难",
          "征粮",
          "黄巾",
          "官军"
        ],
        "keyword_scan_depth": 10,
        "order": 30
      }
    ],
    "generation_params": {
      "temperature": 0.75,
      "top_p": 0.9,
      "max_tokens": 4000
    }
  },
