{
  "format": "dream-mcp-tools",
  "version": 1,
  "tools": [
    {
      "id": "mcp-tool-stock-quote",
      "name": "A股实时行情",
      "description": "查询 A 股个股实时行情（数据来源：腾讯财经 qt.gtimg.cn）。返回名称、现价、涨跌幅、成交量、成交额、换手率、市盈率、行情时间等字段。分析时必须以工具返回的行情时间为准，并在回复中注明数据来源与时间；本工具数据仅供参考，不构成投资建议。",
      "server_name": "builtin-local",
      "tool_name": "stock_quote",
      "enabled": true,
      "exposure_policy": "on-demand",
      "risk_level": "low",
      "trigger_keywords": [
        "股价",
        "行情",
        "现价",
        "涨跌",
        "quote",
        "实时价格"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "带市场前缀的股票代码：上海 sh（如 sh600519）、深圳 sz（如 sz000001）、北京 bj（如 bj920001）。指数：上证指数 sh000001、深证成指 sz399001、创业板指 sz399006。"
          }
        }
      },
      "server_id": "",
      "impl_kind": "builtin_http",
      "impl_config": {
        "mode": "template",
        "method": "GET",
        "url": "https://qt.gtimg.cn/q={{code}}",
        "headers": {
          "Referer": "https://gu.qq.com/"
        },
        "charset": "gbk",
        "allowed_hosts": [
          "qt.gtimg.cn"
        ],
        "extractor": {
          "type": "split_map",
          "pattern": "v_\\w+=\"([^\"]*)\"",
          "delimiter": "~",
          "fields": {
            "1": "名称",
            "2": "代码",
            "3": "现价",
            "4": "昨收",
            "5": "今开",
            "6": "成交量手",
            "30": "行情时间",
            "31": "涨跌额",
            "32": "涨跌幅%",
            "33": "最高",
            "34": "最低",
            "37": "成交额万",
            "38": "换手率%",
            "39": "市盈率"
          }
        }
      }
    },
    {
      "id": "mcp-tool-stock-kline-daily",
      "name": "A股日K线",
      "description": "查询 A 股个股日 K 线（数据来源：东方财富 push2his）。返回 K 线字符串数组，按日期升序、已截取最近 lmt 根；每根为逗号分隔字符串：日期,开盘,收盘,最高,最低,成交量,成交额,振幅%。技术面分析（均线、趋势、量能）必须基于本工具返回的真实数据，不得凭记忆编造价格；回复中注明数据来源。",
      "server_name": "builtin-local",
      "tool_name": "stock_kline_daily",
      "enabled": true,
      "exposure_policy": "on-demand",
      "risk_level": "low",
      "trigger_keywords": [
        "K线",
        "日线",
        "走势",
        "均线",
        "技术面",
        "kline"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "secid",
          "lmt"
        ],
        "properties": {
          "secid": {
            "type": "string",
            "description": "市场.代码：6 开头（上海）用 1.代码，其余（深圳/北京）用 0.代码。例如 1.600519、0.000001。指数：上证指数 1.000001、深证成指 0.399001。"
          },
          "lmt": {
            "type": "number",
            "description": "返回最近 N 根日 K，建议 60，最大 320。"
          }
        }
      },
      "server_id": "",
      "impl_kind": "builtin_http",
      "impl_config": {
        "mode": "template",
        "method": "GET",
        "url": "https://push2his.eastmoney.com/api/qt/stock/kline/get",
        "query": {
          "secid": "{{secid}}",
          "fields1": "f1,f2,f3,f4,f5,f6",
          "fields2": "f51,f52,f53,f54,f55,f56,f57,f58",
          "klt": "101",
          "fqt": "1",
          "end": "20500101",
          "lmt": "{{lmt}}"
        },
        "headers": {
          "Referer": "https://quote.eastmoney.com/"
        },
        "allowed_hosts": [
          "push2his.eastmoney.com"
        ],
        "extractor": {
          "type": "json",
          "path": "data.klines",
          "tail": "{{lmt}}"
        }
      }
    },
    {
      "id": "mcp-tool-stock-kline-daily-sina",
      "name": "A股日K线（新浪备用）",
      "description": "查询 A 股个股日 K 线（数据来源：新浪财经，stock_kline_daily 失败时的备用源）。返回 K 线对象数组，按日期升序、已截取最近 lmt 根；每根字段：day 日期、open 开盘、close 收盘、high 最高、low 最低、volume 成交量（无成交额/振幅，需要这两个字段时用 stock_kline_daily）。",
      "server_name": "builtin-local",
      "tool_name": "stock_kline_daily_sina",
      "enabled": true,
      "exposure_policy": "on-demand",
      "risk_level": "low",
      "trigger_keywords": [
        "K线",
        "日线",
        "走势",
        "均线",
        "技术面",
        "kline"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "code",
          "lmt"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "带市场前缀的股票代码（与 stock_quote 相同）：上海 sh（如 sh600519）、深圳 sz（如 sz000001）、北京 bj（如 bj920001）。指数：上证指数 sh000001、深证成指 sz399001、创业板指 sz399006。"
          },
          "lmt": {
            "type": "number",
            "description": "返回最近 N 根日 K，建议 60，最大 320。"
          }
        }
      },
      "server_id": "",
      "impl_kind": "builtin_http",
      "impl_config": {
        "mode": "template",
        "method": "GET",
        "url": "https://quotes.sina.cn/cn/api/json_v2.php/CN_MarketData.getKLineData",
        "query": {
          "symbol": "{{code}}",
          "scale": "240",
          "ma": "no",
          "datalen": "{{lmt}}"
        },
        "headers": {
          "Referer": "https://finance.sina.com.cn/"
        },
        "allowed_hosts": [
          "quotes.sina.cn"
        ],
        "extractor": {
          "type": "json",
          "tail": "{{lmt}}"
        }
      }
    },
    {
      "id": "mcp-tool-stock-announcements",
      "name": "A股公司公告",
      "description": "查询 A 股个股最新公司公告列表（数据来源：东方财富 datacenter）。返回标题、发布时间、栏目、art_code；公告详情页为 https://data.eastmoney.com/notices/detail/代码/art_code.html。涉及重大事项、业绩、减持等分析时先查本工具，回复中注明公告日期与来源；内容仅供参考，不构成投资建议。",
      "server_name": "builtin-local",
      "tool_name": "stock_announcements",
      "enabled": true,
      "exposure_policy": "on-demand",
      "risk_level": "low",
      "trigger_keywords": [
        "公告",
        "重大事项",
        "业绩",
        "减持",
        "announcement"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "code",
          "page_size"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "纯数字股票代码，不带市场前缀，如 600519、000001。"
          },
          "page_size": {
            "type": "number",
            "description": "返回条数，建议 10。"
          }
        }
      },
      "server_id": "",
      "impl_kind": "builtin_http",
      "impl_config": {
        "mode": "template",
        "method": "GET",
        "url": "https://np-anotice-stock.eastmoney.com/api/security/ann",
        "query": {
          "sr": "-1",
          "page_size": "{{page_size}}",
          "page_index": "1",
          "ann_type": "A",
          "client_source": "web",
          "stock_list": "{{code}}"
        },
        "headers": {
          "Referer": "https://data.eastmoney.com/"
        },
        "allowed_hosts": [
          "np-anotice-stock.eastmoney.com"
        ],
        "extractor": {
          "type": "json",
          "path": "data.list"
        }
      }
    },
    {
      "id": "mcp-tool-market-news",
      "name": "财经快讯",
      "description": "获取最新财经新闻快讯列表（数据来源：新浪财经滚动新闻）。返回标题、链接、时间等。用于了解市场宏观环境与突发消息；回复中注明消息来源与时间，区分事实与观点；内容仅供参考，不构成投资建议。",
      "server_name": "builtin-local",
      "tool_name": "market_news",
      "enabled": true,
      "exposure_policy": "on-demand",
      "risk_level": "low",
      "trigger_keywords": [
        "新闻",
        "快讯",
        "消息",
        "资讯",
        "news"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "num"
        ],
        "properties": {
          "num": {
            "type": "number",
            "description": "返回条数，建议 20。"
          }
        }
      },
      "server_id": "",
      "impl_kind": "builtin_http",
      "impl_config": {
        "mode": "template",
        "method": "GET",
        "url": "https://feed.mix.sina.com.cn/api/roll/get",
        "query": {
          "pageid": "153",
          "lid": "2516",
          "num": "{{num}}",
          "page": "1"
        },
        "headers": {
          "Referer": "https://finance.sina.com.cn/"
        },
        "allowed_hosts": [
          "feed.mix.sina.com.cn"
        ],
        "extractor": {
          "type": "json",
          "path": "result.data"
        }
      }
    }
  ]
}