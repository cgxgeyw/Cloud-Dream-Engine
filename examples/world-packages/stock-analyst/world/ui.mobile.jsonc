{
  "schema_version": 2,
  "meta": {
    "name": "A股投研助手移动界面",
    "author": "Cloud Dream Engine",
    "description": "固定顶栏、报告流和双行输入区；投资面板以抽屉呈现。单智能体世界不显示在场角色栏。"
  },
  "tokens": {
    "color-primary": "#2f5d4a",
    "color-panel": "#f2eee3",
    "color-text": "#1d2824",
    "color-text-muted": "#66716b",
    "radius-md": "4px",
    "radius-lg": "6px",
    "gap": "0",
    "font-body": "'Noto Sans SC', 'Microsoft YaHei', system-ui, sans-serif"
  },
  "components": {},
  "state": {},
  "layout": {
    "root": {
      "type": "stack",
      "class_name": "analyst-mobile-shell",
      "direction": "vertical",
      "gap": "0",
      "padding": "0",
      "style": {
        "height": "var(--game-visual-viewport-height, 100dvh)",
        "min_height": "0",
        "overflow": "hidden"
      },
      "children": [
        {
          "type": "stack",
          "class_name": "analyst-mobile-topbar",
          "direction": "horizontal",
          "gap": "0",
          "style": { "flex": "0 0 74px", "min_width": "0" },
          "children": [
            {
              "type": "component",
              "component": "scene_header",
              "class_name": "analyst-mobile-header",
              "style": { "flex": "1 1 0", "min_width": "0" },
              "props": {
                "show_world_name": true,
                "show_location": true,
                "show_time_label": true,
                "show_player_identity": false,
                "show_visible_characters": false,
                "show_copy_button": false,
                "title_mode": "mobile"
              }
            },
            {
              "type": "component",
              "component": "floating_actions",
              "class_name": "analyst-mobile-actions",
              "props": {
                "show_back": true,
                "show_debug": false,
                "show_settings": false,
                "back_label": "",
                "layout": "row"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "message_list",
          "class_name": "analyst-mobile-story",
          "style": { "flex": "1 1 0", "min_height": "0" },
          "props": {
            "auto_scroll": true,
            "show_pending_state": true,
            "show_agent_reasoning": true,
            "show_typing_indicator": true,
            "mobile_simple": true
          }
        },
        {
          "type": "component",
          "component": "input_composer",
          "class_name": "analyst-mobile-command",
          "style": { "flex": "0 0 auto", "min_height": "0" },
          "props": {
            "placeholder": "想分析哪只 A 股标的？",
            "submit_label": "发送",
            "editing_submit_label": "保存并重发",
            "show_image_button": true,
            "show_audio_button": true,
            "show_session_meta": false,
            "enter_to_submit": true
          }
        },
        {
          "type": "absolute",
          "class_name": "analyst-mobile-overlay",
          "children": [
            {
              "type": "component",
              "component": "side_panel_tabs",
              "class_name": "analyst-mobile-systems",
              "props": {
                "show_map_tab": false,
                "show_attribute_tabs": true,
                "empty_text": "暂无投资面板数据。",
                "drawer_label": "投资"
              }
            }
          ]
        }
      ]
    }
  },
  "custom_css": ""
}
