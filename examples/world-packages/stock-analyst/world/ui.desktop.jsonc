{
  "schema_version": 2,
  "meta": {
    "name": "A股投研助手桌面界面",
    "author": "Cloud Dream Engine",
    "description": "两栏投研工作台：报告流占据主区，投资面板独立滚动。单智能体世界不使用旁白卡。"
  },
  "tokens": {
    "color-primary": "#2f5d4a",
    "color-panel": "#f2eee3",
    "color-text": "#1d2824",
    "color-text-muted": "#66716b",
    "radius-md": "4px",
    "radius-lg": "6px",
    "gap": "0",
    "font-body": "'Noto Sans SC', 'Microsoft YaHei', system-ui, sans-serif",
    "font-display": "'Noto Serif SC', 'Songti SC', serif"
  },
  "components": {},
  "state": {},
  "layout": {
    "root": {
      "type": "grid",
      "class_name": "analyst-desktop-shell",
      "columns": ["minmax(520px, 1fr)", "410px"],
      "rows": ["74px", "minmax(0, 1fr)", "112px"],
      "areas": [
        ["header", "systems"],
        ["chat", "systems"],
        ["input", "systems"]
      ],
      "gap": "0",
      "padding": "0",
      "style": { "height": "100%", "min_height": "0", "overflow": "hidden" },
      "children": [
        {
          "type": "stack",
          "area": "header",
          "class_name": "analyst-desktop-header",
          "direction": "horizontal",
          "gap": "0",
          "style": { "height": "100%", "min_width": "0" },
          "children": [
            {
              "type": "component",
              "component": "scene_header",
              "class_name": "analyst-scene-header",
              "style": { "flex": "1 1 0", "min_width": "0" },
              "props": {
                "show_world_name": true,
                "show_location": true,
                "show_time_label": true,
                "show_player_identity": false,
                "show_visible_characters": false,
                "show_copy_button": false,
                "title_mode": "desktop"
              }
            },
            {
              "type": "component",
              "component": "floating_actions",
              "class_name": "analyst-desktop-actions",
              "props": {
                "show_back": true,
                "show_debug": true,
                "show_settings": true,
                "back_label": "",
                "debug_label": "调试",
                "settings_label": "设置",
                "layout": "row"
              }
            }
          ]
        },
        {
          "type": "stack",
          "area": "chat",
          "class_name": "analyst-story-stage",
          "direction": "vertical",
          "gap": "0",
          "style": { "height": "100%", "min_height": "0" },
          "children": [
            {
              "type": "component",
              "component": "message_list",
              "class_name": "analyst-message-scroll",
              "style": { "flex": "1 1 0", "min_height": "0" },
              "props": {
                "auto_scroll": true,
                "show_pending_state": true,
                "show_agent_reasoning": true,
                "show_typing_indicator": true,
                "mobile_simple": false
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "input_composer",
          "area": "input",
          "class_name": "analyst-command-deck",
          "props": {
            "placeholder": "输入股票名称、代码或想问的投研问题……",
            "submit_label": "发送",
            "editing_submit_label": "保存并重发",
            "show_image_button": true,
            "show_audio_button": true,
            "show_session_meta": false,
            "enter_to_submit": true
          }
        },
        {
          "type": "component",
          "component": "side_panel_tabs",
          "area": "systems",
          "class_name": "analyst-system-ledger",
          "style": { "height": "100%", "min_height": "0", "min_width": "0" },
          "props": {
            "show_map_tab": false,
            "show_attribute_tabs": true,
            "empty_text": "暂无投资面板数据。",
            "drawer_label": "投资"
          }
        }
      ]
    }
  },
  "custom_css": ""
}
