{
  "schema_version": 2,
  "meta": {
    "name": "凡人修仙桌面行旅界面",
    "author": "Cloud Dream Engine",
    "description": "固定三栏叙事工作台：场景、对话和行旅系统各自拥有独立滚动与稳定尺寸。"
  },
  "tokens": {
    "color-primary": "#2f5d4a",
    "color-panel": "#f2eee3",
    "color-text": "#1d2824",
    "color-text-muted": "#66716b",
    "radius-md": "4px",
    "radius-lg": "6px",
    "gap": "0",
    "font-body": "'Noto Sans SC', 'Microsoft YaHei', system-ui, sans-serif",
    "font-display": "'Noto Serif SC', 'Songti SC', serif"
  },
  "components": {},
  "state": {},
  "layout": {
    "root": {
      "type": "grid",
      "class_name": "mortal-desktop-shell",
      "columns": ["272px", "minmax(460px, 1fr)", "410px"],
      "rows": ["74px", "minmax(0, 1fr)", "112px"],
      "areas": [
        ["header", "header", "systems"],
        ["scene", "chat", "systems"],
        ["scene", "input", "systems"]
      ],
      "gap": "0",
      "padding": "0",
      "style": { "height": "100%", "min_height": "0", "overflow": "hidden" },
      "children": [
        {
          "type": "stack",
          "area": "header",
          "class_name": "mortal-desktop-header",
          "direction": "horizontal",
          "gap": "0",
          "style": { "height": "100%", "min_width": "0" },
          "children": [
            {
              "type": "component",
              "component": "scene_header",
              "class_name": "mortal-scene-header",
              "style": { "flex": "1 1 0", "min_width": "0" },
              "props": {
                "show_world_name": true,
                "show_location": true,
                "show_time_label": true,
                "show_player_identity": true,
                "player_identity_format": "action_phrase",
                "show_visible_characters": false,
                "show_copy_button": false,
                "title_mode": "desktop"
              }
            },
            {
              "type": "component",
              "component": "floating_actions",
              "class_name": "mortal-desktop-actions",
              "props": {
                "show_back": true,
                "show_debug": true,
                "show_settings": true,
                "back_label": "",
                "debug_label": "调试",
                "settings_label": "设置",
                "layout": "row"
              }
            }
          ]
        },
        {
          "type": "stack",
          "area": "scene",
          "class_name": "mortal-scene-rail",
          "direction": "vertical",
          "gap": "0",
          "style": { "height": "100%", "min_height": "0" },
          "children": [
            {
              "type": "component",
              "component": "scene_focus",
              "class_name": "mortal-scene-focus",
              "style": { "flex": "1 1 0", "min_height": "0" },
              "props": { "show_avatar": true, "show_line": true, "avatar_variant": "focus" }
            },
            {
              "type": "component",
              "component": "character_bar",
              "class_name": "mortal-character-roster",
              "props": { "empty_text": "此处暂时无人", "max_items": 7, "show_player": false }
            }
          ]
        },
        {
          "type": "stack",
          "area": "chat",
          "class_name": "mortal-story-stage",
          "direction": "vertical",
          "gap": "0",
          "style": { "height": "100%", "min_height": "0" },
          "children": [
            {
              "type": "component",
              "component": "narration_card",
              "class_name": "mortal-narration-strip",
              "props": { "title": "场景", "show_copy_button": false, "empty_text": "山风未定，前路尚待落笔。" }
            },
            {
              "type": "component",
              "component": "message_list",
              "class_name": "mortal-message-scroll",
              "style": { "flex": "1 1 0", "min_height": "0" },
              "props": {
                "auto_scroll": true,
                "show_pending_state": true,
                "show_agent_reasoning": true,
                "show_typing_indicator": true,
                "mobile_simple": false
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "input_composer",
          "area": "input",
          "class_name": "mortal-command-deck",
          "props": {
            "placeholder": "写下陆谨此刻的言语、判断或行动……",
            "submit_label": "行动",
            "editing_submit_label": "保存并重演",
            "show_image_button": true,
            "show_audio_button": true,
            "show_session_meta": false,
            "enter_to_submit": true
          }
        },
        {
          "type": "component",
          "component": "side_panel_tabs",
          "area": "systems",
          "class_name": "mortal-system-ledger",
          "style": { "height": "100%", "min_height": "0", "min_width": "0" },
          "props": {
            "show_map_tab": true,
            "show_attribute_tabs": true,
            "empty_text": "行旅状态尚未建立。",
            "drawer_label": "行囊"
          }
        }
      ]
    }
  },
  "custom_css": ""
}
